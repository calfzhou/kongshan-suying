{
  /* --- 输入状态区 (Input Pre-edit) --- */
  "preeditFontSize": 17,                     // 输入编码（如拼音串）字体

  /* --- 工具栏与悬浮窗 (Toolbar & Floating) --- */
  "toolbarButtonTextFontSize": 16,           // 工具栏按钮文字
  "toolbarButtonImageFontSize": 20,          // 工具栏按钮图标
  "floatingKeyboardButtonTextFontSize": 14,  // 悬浮键盘文字
  "floatingKeyboardButtonImageFontSize": 20, // 悬浮键盘图标

  /* --- 基础按键 (Standard Buttons) --- */
  "standardButtonTextFontSize": 16,          // 常规按键文字
  "standardButtonUppercasedTextFontSize": 20, // 常规按键大写文字
  "standardButtonImageFontSize": 20,         // 常规按键图标
  "t9ButtonTextFontSize": 18,                // 九宫格数字/字母
  "numericButtonTextFontSize": 22.5,         // 纯数字键盘文字

  /* --- 系统与特殊键 (System & Special) --- */
  "systemButtonTextFontSize": 18,            // 系统键（回车/空格等）文字
  "systemButtonImageFontSize": 20,           // 系统键图标
  "candidateStateButtonFontSize": 20,        // 状态切换按钮（中/英）

  /* --- 辅助信息 (Hints & Alternative) --- */
  "alternativeTextFontSize": 10,             // 按键角标文字（上划提示）
  "alternativeImageFontSize": 9,             // 按键角标图标
  "hintTextFontSize": 20,                  // 长按预览气泡文字
  "hintImageFontSize": 20,                   // 长按预览气泡图标

  /* --- 候选词区域 (Candidate Area) --- */
  "candidateTextFontSize": 16,               // 候选词主体文字
  "candidateIndexFontSize": 12,              // 候选词序号
  "candidateCommentFontSize": 14             // 候选词注解/翻译
}
